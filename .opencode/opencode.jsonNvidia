{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/qwen/qwen3-coder-480b-a35b-instruct",
  "small_model": "nvidia/deepseek-ai/deepseek-v4-flash",
  "default_agent": "chat",
  "autoshare": false,
  "instructions": [
    "/Users/himanshusao/.config/opencode/AGENTS.md"
  ],
  "plugin": [],
  "agent": {
    "chat": {
      "description": "Entry point assistant. Coordinates the Expert-Direct workflow.",
      "mode": "primary",
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "tools": {
        "read": true,
        "bash": true,
        "task": true
      },
      "instructions": [
        "/Users/himanshusao/.config/opencode/AGENTS.md",
        "/Users/himanshusao/.config/opencode/agents/chat.md"
      ]
    },
    "project-manager": {
      "description": "PHASE 1: Planning. Creates docs/PLAN.md.",
      "mode": "subagent",
      "model": "nvidia/meta/llama-3.3-70b-instruct",
      "tools": {
        "read": true,
        "write": true,
        "bash": true
      },
      "instructions": [
        "/Users/himanshusao/.config/opencode/agents/project-manager.md"
      ]
    },
    "architect": {
      "description": "PHASE 2: Architecture. Creates docs/ARCHITECTURE.md.",
      "mode": "subagent",
      "model": "nvidia/meta/llama-3.3-70b-instruct",
      "tools": {
        "read": true,
        "write": true,
        "bash": true
      },
      "instructions": [
        "/Users/himanshusao/.config/opencode/agents/architect.md"
      ]
    },
    "tech-lead": {
      "description": "The Ultimate Router. Send all your requests here.",
      "mode": "subagent",
      "model": "nvidia/deepseek-ai/deepseek-v4-flash",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "task": true
      },
      "instructions": [
        "/Users/himanshusao/.config/opencode/AGENTS.md",
        "/Users/himanshusao/.config/opencode/agents/tech-lead.md"
      ]
    },
    "developer": {
      "description": "PHASE 3: Implementation. Writes the code based on architecture.",
      "mode": "subagent",
      "model": "nvidia/qwen/qwen3-coder-480b-a35b-instruct",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true
      },
      "instructions": [
        "/Users/himanshusao/.config/opencode/agents/developer.md"
      ]
    }
  },
  "provider": {
    "local-bridge": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Bridge (Tool-Enabled)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "Gemma 4",
          "tool_call": true,
          "reasoning": false
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Nvidia NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_BUILD_SAMPLE_API_KEY}"
      },
      "models": {
        "qwen/qwen3-coder-480b-a35b-instruct": {
          "name": "Qwen3 Coder 480B",
          "tool_call": true,
          "reasoning": true,
          "options": {
            "temperature": 0.1
          }
        },
        "meta/llama-3.3-70b-instruct": {
          "name": "Llama 3.3 70B",
          "tool_call": true,
          "reasoning": true,
          "options": {
            "temperature": 0.1
          }
        },
        "deepseek-ai/deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "tool_call": true,
          "reasoning": false,
          "options": {
            "temperature": 0.1
          }
        }
      }
    }
  }
}