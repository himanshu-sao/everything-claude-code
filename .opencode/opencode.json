{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4:e4b",
  "small_model": "ollama/deepseek-coder:1.3b",
  "default_agent": "chat",
  "autoshare": false,
  "instructions": [],
  "plugin": [],
  "agent": {
    "chat": {
      "description": "Entry point assistant for greetings and dispatching",
      "mode": "primary",
      "model": "ollama/mistral:7b",
      "instructions": ["agents/chat.md"]
    },
    "architect": {
      "description": "Technical architect for system design and ADRs",
      "model": "ollama/gemma4:e4b",
      "instructions": ["agents-archive/architect.md"]
    },
    "planner": {
      "description": "Implementation planner for feature breakdown",
      "model": "ollama/gemma4:e4b",
      "instructions": ["agents-archive/planner.md"]
    },
    "dispatcher": {
      "description": "High-intelligence task routing and orchestration",
      "model": "ollama/gemma4:e4b",
      "instructions": ["agents-archive/dispatcher.md"]
    },
    "ba-agent": {
      "description": "Business analyst for requirements and Jira",
      "model": "ollama/mistral:7b",
      "instructions": ["agents-archive/ba-agent.md"]
    },
    "builder": {
      "description": "Full-stack application builder",
      "model": "ollama/qwen3-coder:latest",
      "instructions": ["agents-archive/builder.md"]
    },
    "python-agent": {
      "description": "Python, Django, and Fast API specialist",
      "model": "ollama/qwen3-coder:latest",
      "instructions": ["agents-archive/python-agent.md"]
    },
    "java-agent": {
      "description": "Java, Spring Boot, and Maven specialist",
      "model": "ollama/qwen3-coder:latest",
      "instructions": ["agents-archive/java-agent.md"]
    },
    "go-agent": {
      "description": "Golang and microservices specialist",
      "model": "ollama/qwen3-coder:latest",
      "instructions": ["agents-archive/go-agent.md"]
    },
    "database-reviewer": {
      "description": "SQL and Database architecture specialist",
      "model": "ollama/mistral:7b",
      "instructions": ["agents-archive/database-reviewer.md"]
    },
    "security-reviewer": {
      "description": "Security audit and vulnerability specialist",
      "model": "ollama/mistral:7b",
      "instructions": ["agents-archive/security-reviewer.md"]
    },
    "code-reviewer": {
      "description": "Code quality and maintainability specialist",
      "model": "ollama/mistral:7b",
      "instructions": ["agents-archive/code-reviewer.md"]
    },
    "tdd-guide": {
      "description": "Test Driven Development and coverage specialist",
      "model": "ollama/mistral:7b",
      "instructions": ["agents-archive/tdd-guide.md"]
    },

    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary",
      "model": "ollama/qwen3-coder:latest",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "changed-files": true
      }
    }
  },
  "command": {
    "plan": {
      "description": "Create a detailed implementation plan for complex features",
      "template": "{file:commands/plan.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "tdd": {
      "description": "Enforce TDD workflow with 80%+ test coverage",
      "template": "{file:commands/tdd.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:commands/code-review.md}\n\n$ARGUMENTS",
      "agent": "code-reviewer",
      "subtask": true
    },
    "security": {
      "description": "Run comprehensive security review",
      "template": "{file:commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-reviewer",
      "subtask": true
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:commands/build-fix.md}\n\n$ARGUMENTS",
      "agent": "build-error-resolver",
      "subtask": true
    },
    "e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:commands/e2e.md}\n\n$ARGUMENTS",
      "agent": "e2e-runner",
      "subtask": true
    },
    "refactor-clean": {
      "description": "Remove dead code and consolidate duplicates",
      "template": "{file:commands/refactor-clean.md}\n\n$ARGUMENTS",
      "agent": "refactor-cleaner",
      "subtask": true
    },
    "orchestrate": {
      "description": "Orchestrate multiple agents for complex tasks",
      "template": "{file:commands/orchestrate.md}\n\n$ARGUMENTS",
      "agent": "planner",
      "subtask": true
    },
    "learn": {
      "description": "Extract patterns and learnings from session",
      "template": "{file:commands/learn.md}\n\n$ARGUMENTS"
    },
    "checkpoint": {
      "description": "Save verification state and progress",
      "template": "{file:commands/checkpoint.md}\n\n$ARGUMENTS"
    },
    "verify": {
      "description": "Run verification loop",
      "template": "{file:commands/verify.md}\n\n$ARGUMENTS"
    },
    "eval": {
      "description": "Run evaluation against criteria",
      "template": "{file:commands/eval.md}\n\n$ARGUMENTS"
    },
    "update-docs": {
      "description": "Update documentation",
      "template": "{file:commands/update-docs.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subtask": true
    },
    "update-codemaps": {
      "description": "Update codemaps",
      "template": "{file:commands/update-codemaps.md}\n\n$ARGUMENTS",
      "agent": "doc-updater",
      "subtask": true
    },
    "test-coverage": {
      "description": "Analyze test coverage",
      "template": "{file:commands/test-coverage.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "setup-pm": {
      "description": "Configure package manager",
      "template": "{file:commands/setup-pm.md}\n\n$ARGUMENTS"
    },
    "go-review": {
      "description": "Go code review",
      "template": "{file:commands/go-review.md}\n\n$ARGUMENTS",
      "agent": "go-reviewer",
      "subtask": true
    },
    "go-test": {
      "description": "Go TDD workflow",
      "template": "{file:commands/go-test.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "go-build": {
      "description": "Fix Go build errors",
      "template": "{file:commands/go-build.md}\n\n$ARGUMENTS",
      "agent": "go-build-resolver",
      "subtask": true
    },
    "skill-create": {
      "description": "Generate skills from git history",
      "template": "{file:commands/skill-create.md}\n\n$ARGUMENTS"
    },
    "instinct-status": {
      "description": "View learned instincts",
      "template": "{file:commands/instinct-status.md}\n\n$ARGUMENTS"
    },
    "instinct-import": {
      "description": "Import instincts",
      "template": "{file:commands/instinct-import.md}\n\n$ARGUMENTS"
    },
    "instinct-export": {
      "description": "Export instincts",
      "template": "{file:commands/instinct-export.md}\n\n$ARGUMENTS"
    },
    "evolve": {
      "description": "Cluster instincts into skills",
      "template": "{file:commands/evolve.md}\n\n$ARGUMENTS"
    },
    "promote": {
      "description": "Promote project instincts to global scope",
      "template": "{file:commands/promote.md}\n\n$ARGUMENTS"
    },
    "projects": {
      "description": "List known projects and instinct stats",
      "template": "{file:commands/projects.md}\n\n$ARGUMENTS"
    },
    "update-mcps": {
      "description": "Manually update all MCP servers to latest (takes 1-2 mins)",
      "template": "sh /Users/himanshusao/.opencode/scripts/update-mcps.sh"
    }
  },
  "provider": {
    "google": {
      "models": {
        "gemini-2.0-flash": {
          "reasoning": false
        }
      }
    },
    "groq": {
      "models": {
        "llama-3.3-70b-versatile": {
          "reasoning": false
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "gemma4:e4b": {
          "name": "Gemma 4 E4B - Advanced Reasoning (9.6 GB)",
          "tool_call": true,
          "reasoning": true
        },
        "qwen3-coder:latest": {
          "name": "Qwen3 Coder - SOTA Coding (18 GB)",
          "tool_call": true,
          "reasoning": true
        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B - Creative Writing (13 GB)",
          "reasoning": true,
          "tool_call": true
        },
        "deepseek-coder:1.3b": {
          "name": "DeepSeek Coder - Ultra-Fast Coding (776 MB)",
          "tool_call": false,
          "reasoning": false
        },
        "mistral:7b": {
          "name": "Mistral 7B - Smart Generalist (4.4 GB)",
          "tool_call": true,
          "reasoning": false
        },
        "codellama:7b": {
          "name": "CodeLlama 7B - Legacy Coding (3.8 GB)",
          "tool_call": false,
          "reasoning": false
        },
        "nomic-embed-text:latest": {
          "name": "Nomic Embed - Text Vectorization (274 MB)",
          "tool_call": false,
          "reasoning": false
        },
        "glm-5:cloud": {
          "name": "GLM-5 Cloud - Pro Multi-modal (-)",
          "tool_call": true,
          "reasoning": false
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B - Smart Entry (2.0 GB)",
          "tool_call": true,
          "reasoning": false
        }
      }
    }
  },
  "permission": {
    "mcp_*": "ask"
  }
}