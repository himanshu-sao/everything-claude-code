  "provider": {
    "google": {
      "models": {
        "gemini-2.0-flash": {
          "reasoning": false
        }
      }
    },
    "groq": {
      "models": {
        "llama-3.3-70b-versatile": {
          "reasoning": false
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "codestral": {
          "name": "Codestral 22B - Reliable Agentic Coding (14 GB)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32000,
            "output": 4096
          }
        },
        "MFDoom/deepseek-coder-v2-tool-calling:latest": {
          "name": "DeepSeek Coder v2 (MFDoom) - Advanced Coding (8.9 GB)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 64000,
            "output": 4096
          }
        },
        "gemma4:e4b": {
          "name": "Gemma 4 E4B - Advanced Reasoning (9.6 GB)",
          "limit": {
            "context": 120000,
            "output": 4096
          },
          "tool_call": true,
          "reasoning": true
        },
        "gpt-oss:latest": {
          "name": "GPT-OSS 20B - Creative Writing (13 GB)",
          "reasoning": true,
          "tool_call": true
        },
        "deepseek-coder:1.3b": {
          "name": "DeepSeek Coder - Ultra-Fast Coding (776 MB)",
          "tool_call": false,
          "reasoning": false
        },
        "mistral:7b": {
          "name": "Mistral 7B - Smart Generalist (4.4 GB)",
          "tool_call": true,
          "reasoning": false
        },
        "codellama:7b": {
          "name": "CodeLlama 7B - Legacy Coding (3.8 GB)",
          "tool_call": false,
          "reasoning": false
        },
        "nomic-embed-text:latest": {
          "name": "Nomic Embed - Text Vectorization (274 MB)",
          "tool_call": false,
          "reasoning": false
        },
        "glm-5:cloud": {
          "name": "GLM-5 Cloud - Pro Multi-modal (-)",
          "tool_call": true,
          "reasoning": false
        },
        "codestral:latest": {
          "name": "Codestral 22B - Reliable Agentic Coding (12 GB)",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 32000,
            "output": 4096
          }
        },
        "llama3.2:3b": {
          "name": "Llama 3.2 3B - Smart Entry (2.0 GB)",
          "tool_call": true,
          "reasoning": false
        }
      }
    }
