{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/gemma4:e4b",
  "small_model": "ollama/deepseek-coder:1.3b",
  "default_agent": "chat",
  "autoshare": false,
  "instructions": [".opencode/instructions/AGENTS.md"],
  "plugin": [],
  "agent": {
    "chat": {
      "description": "Entry point assistant for greetings and dispatching",
      "mode": "primary",
      "model": "ollama/gemma4:e4b",
      "tools": {
        "read": true,
        "write": true,
        "edit": true,
        "bash": true,
        "task": true
      },
      "instructions": [".opencode/instructions/AGENTS.md", ".opencode/agents/chat.md"]
    },
    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary",
      "model": "ollama/deepseek-coder-v2",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "changed-files": true
      }
    }
  },
  "command": {
    "plan": {
      "description": "Create a detailed implementation plan for complex features",
      "template": "{file:.opencode/commands/plan.md}\n\n$ARGUMENTS",
      "agent": "project-manager",
      "subtask": true
    },
    "tdd": {
      "description": "Enforce TDD workflow with 80%+ test coverage",
      "template": "{file:.opencode/commands/tdd.md}\n\n$ARGUMENTS",
      "agent": "tdd-guide",
      "subtask": true
    },
    "code-review": {
      "description": "Review code for quality, security, and maintainability",
      "template": "{file:.opencode/commands/code-review.md}\n\n$ARGUMENTS",
      "agent": "code-reviewer",
      "subtask": true
    },
    "security": {
      "description": "Run comprehensive security review",
      "template": "{file:.opencode/commands/security.md}\n\n$ARGUMENTS",
      "agent": "security-reviewer",
      "subtask": true
    },
    "build-fix": {
      "description": "Fix build and TypeScript errors with minimal changes",
      "template": "{file:.opencode/commands/build-fix.md}\n\n$ARGUMENTS",
      "agent": "build-error-resolver",
      "subtask": true
    },
    "e2e": {
      "description": "Generate and run E2E tests with Playwright",
      "template": "{file:.opencode/commands/e2e.md}\n\n$ARGUMENTS",
      "agent": "e2e-runner"
    },
    "design": {
      "description": "Run the full design pipeline (plan -> architecture -> quality-gate -> qa-plan -> tdd stubs) with user gate checkpoints",
      "template": "{file:.opencode/commands/design.md}\n\n$ARGUMENTS",
      "agent": "pipeline-orchestrator",
      "subtask": true
    },
    "qa-plan": {
      "description": "Generate a QA test matrix document for the current feature",
      "template": "Read docs/PLAN.md and docs/ARCHITECTURE.md, then produce docs/QA_TESTCASES.md with a full test matrix.\n\n$ARGUMENTS",
      "agent": "qa-planner",
      "subtask": true
    }
  }
}
